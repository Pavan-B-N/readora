# Database
POSTGRES_PASSWORD=your_secure_postgres_password

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_for_signing_tokens
GATEWAY_SECRET=your_api_gateway_secret

# Azure OpenAI (Required for ai-service)
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_CHAT_DEPLOYMENT=your_chat_deployment_name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your_embedding_deployment_name

# Observability (Optional, required if tracing export is enabled via otel-collector)
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# Virtual-edition file storage — Azure Blob Storage (Required for the /books/{id}/read endpoint).
# Left unset, that endpoint fails per-request with a generic error rather than at service startup.
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER_NAME=readora-virtual-editions
