# Reference only — NOT a real .env file, not auto-loaded by anything.
#
# The OTel Java agent's premain runs before Spring boots, so it can't see values from a
# service's own .env (Spring loads those later, via spring.config.import). These have to be
# pasted directly into each service's IntelliJ run configuration:
#
#   VM options:            -javaagent:$PROJECT_DIR$/infra/otel/opentelemetry-javaagent.jar
#   Environment variables:  the block for that service below
#
# OTEL_SDK_DISABLED=true means fully off by default — flip it to false for one run when you
# actually want traces/metrics/logs to flow. Everything else can stay as-is.
#
# Run infra/otel/download-agent.sh once after cloning to fetch the agent jar (not committed —
# it's a 24MB binary).

# ── auth-service ──────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=auth-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_LOGS_EXPORTER=otlp
OTEL_SDK_DISABLED=true

